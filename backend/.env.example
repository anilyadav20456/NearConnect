# NearConnect Backend Environment Variables (Render / Local)
SECRET_KEY=nearconnect-production-secret-key-change-this
JWT_SECRET_KEY=nearconnect-jwt-secret-key-change-this
DATABASE_URL=sqlite:///nearconnect.db
CORS_ORIGINS=*

# Brevo Email Service Configuration (Optional / Transactional Email)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_NAME=NearConnect
BREVO_SENDER_EMAIL=noreply@nearconnect.com
